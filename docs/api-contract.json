    "scope": "VersionCode, matching user-agent and original sys/app/upt version query only",
    "verification": "distribution metadata discovery only; not APK signature or business compatibility proof",
    "storage": "installation-wide originalAppVersion; retained on logout; no preview writes",
    "refresh": "first foreground, then 6h on success or 5min on failure per process; manual bypass"
