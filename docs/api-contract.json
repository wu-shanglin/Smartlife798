  "headers": {
    "ApplicationType": "1,1",
    "VersionCode": "3.1.9",
    "user-agent": "Android_ilife798_3.1.9",
    "Authorization": "<login token>"
  },
  "envelope": {
    "code": "int, >=0 success",
    "msg": "string",
    "data": "T",
    "size": "int?",
    "time": "long"
  },
  "errorCodes": {
    "-1": "通用业务失败，按端点与 msg 判断；可为请求参数错误或请升级最新版APP，不能仅凭 code 判为版本门禁",
    "-2": "图片验证码错误",
    "-17": "余额不足（客户端引导充值）",
    "-18": "余额不足（客户端引导充值）",
    "-20": "一卡通未绑定",
    "-28": "需要支付（客户端弹去支付）",
    "-52": "存在付款失败账单",
    "-87": "扣款失败/余额不足",
    "-88": "未开通或未签约支付",
    "-98": "需要支付宝账号补齐 oid",
    "-99": "登录状态已过期"
  },
