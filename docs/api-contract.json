  "accountBehavior": {
    "profilePatch": "POST acc/upt sends one of name or useScore only; account changes are guarded and only server success updates local state",
    "points": "master.pltTotalScore is the points display value; account.useScore 0/1 is the persisted server preference, not a balance or dev/start parameter",
    "avatar": "account.img is a direct URL (MeFragment.M -> ImageUtils.e -> Glide.load); this client uses HTTPS without business credentials and falls back locally; no invented fs/dl key conversion",
    "autoCheckIn": {
      "default": true,
      "trigger": "foreground signed-in session or login while foreground, configurable in Me; no Preview IO or persistent writes",
      "clock": "positive server envelope time plus monotonic elapsed since snapshot; Asia/Shanghai day and Monday=1 weekday; do not submit a stale snapshot after midnight",
      "prepare": "require explicit unsigned current-day bitmap plus valid server dailyRSP.adId/score; missing daily/week remains unknown even though original v3.1.5 fell back to zero",
      "digest": "lowercase MD5(adId + decimal(floor(adjustedServerMs/10000)*10) + last8(token) + last8(uid) + fixed25ByteSalt); never log inputs, digest, or signed request URL",
      "identity": "original native implementation gates on its app certificate; user explicitly authorized a separate implementation with this app's own package/certificate and legitimate login; no original library, private key or official identity spoofing",
      "deduplication": "synchronously persist current-account day attempt before POST; same foreground reentry/process recreation first queries state and does not resubmit that day; explicit logout clears account attempt, new login queries state again",
      "confirmation": "after accepted POST, GET missions again and require same-day signed bitmap; timeout/cancellation/failure/unknown state is unconfirmed, with no automatic write retry or fabricated points",
      "validation": "v3.1.5 REA Java methods + LLVM arm64 static native instructions and independent synthetic Python/JVM vectors; original native runtime equivalence, protected v3.1.9 fields, real account mutations and rewards remain unverified"
    },
