      "notes": "v3.1.5 ModifyNameActivity.h0 and BaseDeviceDetailActivity.Y0 -> UserVM.j -> c4.m.h0; omit unrelated fields; update local profile only after success; no current live account mutation executed"
    },
    {
      "method": "GET",
      "path": "/api/v1/acc/score/mission-lst",
      "response": "Missions{accScoreRsp{validScore,daily{ltime,week}},dailyRSP{adId,score}}",
      "use": "query daily points-check-in status and server reward",
      "verified": "static",
      "notes": "v3.1.5 d4.g.b and SignInFragment.z0; week is Monday bit0 through Sunday bit6; use response envelope time for China day; missing or invalid bitmap/reward/time is unknown and does not authorize automatic submission"
    },
    {
      "method": "POST",
      "path": "/api/v1/acc/score/score-send",
      "query": [
        "sign (session-bound lowercase MD5 digest)",
        "s=1"
      ],
      "body": [
        "adId (server dailyRSP.adId)",
        "weekday (Monday=1 through Sunday=7)",
        "addScoreType=1",
        "addScore (server dailyRSP.score)"
      ],
      "response": "BaseReq",
      "use": "normal daily check-in only; omit type, no retroactive or advertising reward",
      "verified": "static",
      "notes": "v3.1.5 SignInFragment.q0 -> BaseTaskFragment.V -> nativeSign; independent authorized digest implementation under this app's own identity and legitimate session; no original SO/certificate reuse; persist same-account day attempt before request, never automatically retry; read mission-lst after acceptance and require same-day signed bit before success"
